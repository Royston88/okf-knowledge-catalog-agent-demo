{
  "name": "okf",
  "type": "record",
  "recordFields": [
    {
      "index": 1,
      "name": "okf_type",
      "type": "string",
      "annotations": {
        "displayName": "OKF Type",
        "description": "The OKF document type (freeform, e.g. 'BigQuery Dataset').",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 2,
      "name": "generated",
      "type": "record",
      "recordFields": [
        {
          "index": 1,
          "name": "by",
          "type": "string",
          "annotations": {
            "displayName": "Generated By",
            "description": "Actor that generated the document (e.g. 'reference_agent/gemini-3.5-flash')."
          }
        },
        {
          "index": 2,
          "name": "at",
          "type": "string",
          "annotations": {
            "displayName": "Generated At",
            "description": "ISO 8601 timestamp when the document was generated."
          }
        }
      ],
      "annotations": {
        "displayName": "Generated",
        "description": "Provenance of the document content."
      }
    },
    {
      "index": 3,
      "name": "sources",
      "type": "array",
      "arrayItems": {
        "name": "source",
        "type": "record",
        "recordFields": [
          {
            "index": 1,
            "name": "id",
            "type": "string",
            "annotations": {
              "displayName": "Source ID",
              "description": "Footnote identifier referenced from the body as [^id]."
            }
          },
          {
            "index": 2,
            "name": "resource",
            "type": "string",
            "constraints": {
              "required": true
            },
            "annotations": {
              "displayName": "Resource",
              "description": "URI of the source."
            }
          },
          {
            "index": 3,
            "name": "title",
            "type": "string",
            "annotations": {
              "displayName": "Title",
              "description": "Human-readable title of the source."
            }
          }
        ]
      },
      "annotations": {
        "displayName": "Sources",
        "description": "Attribution sources for the document content."
      }
    },
    {
      "index": 4,
      "name": "verified",
      "type": "array",
      "arrayItems": {
        "name": "verification",
        "type": "record",
        "recordFields": [
          {
            "index": 1,
            "name": "by",
            "type": "string",
            "constraints": {
              "required": true
            },
            "annotations": {
              "displayName": "Verified By",
              "description": "Actor that confirmed the content against its sources or the underlying resource. A 'human:<id>' prefix marks human-reviewed; anything else is machine-confirmed.",
              "search": {
                "retrievable": true
              }
            }
          },
          {
            "index": 2,
            "name": "at",
            "type": "string",
            "annotations": {
              "displayName": "Verified At",
              "description": "ISO 8601 timestamp of the confirmation."
            }
          }
        ]
      },
      "annotations": {
        "displayName": "Verified",
        "description": "Independent confirmations of the content. Absent = unverified. OKF v0.2 trust tier: no key = unverified; machine actors only = machine-confirmed; a human:<id> actor = human-reviewed. Advisory signal, not access control."
      }
    },
    {
      "index": 5,
      "name": "status",
      "type": "string",
      "annotations": {
        "displayName": "Status",
        "description": "Lifecycle: draft | stable | deprecated. Absent means stable.",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 6,
      "name": "stale_after",
      "type": "string",
      "annotations": {
        "displayName": "Stale After",
        "description": "Absolute date after which the content should be treated as potentially out of date."
      }
    },
    {
      "index": 7,
      "name": "title",
      "type": "string",
      "annotations": {
        "displayName": "OKF Title",
        "description": "The concept's OKF title. Carried here because on an INGESTED entry (@bigquery) `entry_source.displayName` is platform-owned and cannot hold it, so without this the title cannot survive a pull.",
        "search": {
          "retrievable": true
        }
      }
    },
    {
      "index": 8,
      "name": "tags",
      "type": "array",
      "arrayItems": {
        "name": "tag",
        "type": "string"
      },
      "annotations": {
        "displayName": "OKF Tags",
        "description": "The concept's OKF tags. Same reason as `title`: on an ingested entry `entry_source.labels` is platform-owned, so tags would be lost on pull."
      }
    }
  ],
  "annotations": {
    "displayName": "OKF Signal",
    "description": "Open Knowledge Format v0.2 signal layer (type, provenance, sources, trust, lifecycle, freshness)."
  }
}
